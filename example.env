# Copy this to .env and edit — APP_AUTH_TOKEN below is REQUIRED (the API
# refuses every request until it's set); everything else overrides the
# local-dev defaults baked into docker-compose.yml. See README.md.
#
#   cp example.env .env

# Credentials for pgdba-store — this app's OWN history/metrics database.
# Not the credentials for any database you want to monitor.
STORE_POSTGRES_USER=pgdba
STORE_POSTGRES_PASSWORD=pgdba
STORE_POSTGRES_DB=pgdba_store

# REQUIRED (with the default below, the backend refuses to start). Encrypts
# stored target connection passwords, AI provider keys, and webhook URLs at
# rest. Generate one the same way as APP_AUTH_TOKEN:
#   openssl rand -hex 32
APP_SECRET_KEY=dev-only-insecure-key-change-me

# Only for a genuinely disposable local instance: set to "true" to let the
# backend start with the insecure APP_SECRET_KEY default above instead of
# refusing to boot. Leave unset/false for anything real.
APP_ALLOW_INSECURE_SECRET_KEY=false

# REQUIRED. The API rejects every request with no token set — the UI will
# prompt for this same value on first load. Generate one with:
#   openssl rand -hex 32
# or:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_AUTH_TOKEN=dev-only-insecure-key-change-me

# Optional demo target (only started with --profile demo).
DEMO_POSTGRES_USER=demo
DEMO_POSTGRES_PASSWORD=demo
DEMO_POSTGRES_DB=demo

# Host ports. Change any of these if the default is already taken on your
# machine — pre-flight.sh will tell you which one.
UI_PORT=5173
BACKEND_PORT=8000
DEMO_PORT=5433
