# Copy this to .env and edit — APP_AUTH_TOKEN below is REQUIRED (the API
# refuses every request until it's set); everything else overrides the
# local-dev defaults baked into docker-compose.yml. See README.md.
#
#   cp example.env .env

# Credentials for pgdba-store — this app's OWN history/metrics database.
# Not the credentials for any database you want to monitor.
STORE_POSTGRES_USER=pgdba
STORE_POSTGRES_PASSWORD=pgdba
STORE_POSTGRES_DB=pgdba_store

# REQUIRED (with the default below, the backend refuses to start). Encrypts
# stored target connection passwords, AI provider keys, and webhook URLs at
# rest. Generate one the same way as APP_AUTH_TOKEN:
#   openssl rand -hex 32
APP_SECRET_KEY=dev-only-insecure-key-change-me

# Only for a genuinely disposable local instance: set to "true" to let the
# backend start with the insecure APP_SECRET_KEY default above instead of
# refusing to boot. Leave unset/false for anything real.
APP_ALLOW_INSECURE_SECRET_KEY=false

# REQUIRED. The API rejects every request with no token set — the UI will
# prompt for this same value on first load. The backend refuses to start if
# it's a well-known value or shorter than 32 characters. Generate one with:
#   openssl rand -hex 32
# or:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_AUTH_TOKEN=

# Optional demo target (only started with --profile demo).
DEMO_POSTGRES_USER=demo
DEMO_POSTGRES_PASSWORD=demo
DEMO_POSTGRES_DB=demo

# Optional TimescaleDB test target (docker-compose.timescaledb.yml).
TSDB_POSTGRES_USER=tsdemo
TSDB_POSTGRES_PASSWORD=tsdemo
TSDB_POSTGRES_DB=tsdemo
TSDB_PORT=5434

# Log to files. When true, every container also writes its own log file into
# LOG_HOST_DIR (default ./logs): backend.log, ui-access.log, ui-error.log,
# store.log, demo-target.log, timescale-target.log. Postgres containers write
# ONLY to the file while this is on (they stop logging to `docker compose
# logs`). On Linux hosts the directory must be writable by the containers'
# unprivileged users — postgres, and the backend's own uid 10001 — e.g.
# `chmod 777 logs`. If it isn't, the backend keeps running and logs a warning.
LOG_TO_FILE=false
#LOG_HOST_DIR=./logs

# Host ports. Change any of these if the default is already taken on your
# machine — pre-flight.sh will tell you which one.
UI_PORT=5173
BACKEND_PORT=8000
DEMO_PORT=5433

# The UI container (nginx) proxies /api/* to the backend itself (see
# ui/nginx.conf), so putting a reverse proxy with its own hostname in front
# of the UI (e.g. https://dbbutler.example.com) needs no config here — the
# browser only ever talks to that one hostname. Only relevant if something
# OTHER than this UI calls the backend directly on BACKEND_PORT and needs
# CORS access:
#   CORS_ALLOWED_ORIGINS=https://your-other-caller-hostname

# Backend tuning — the defaults suit a handful of monitored databases.
# How many monitored databases each background job works on at once (one
# slow or unreachable database no longer holds up the others):
#SCHEDULER_MAX_PARALLEL_TARGETS=4
# Connection pool to the app's own store database:
#STORE_POOL_MAX_SIZE=20
# Refactoring Advisor: smallest table (MB) ever suggested for partitioning.
# The demo tables are tiny — set this to 5 to see the rule fire on
# demo's audit_log:
#REFACTOR_PARTITION_MIN_TABLE_MB=1024
